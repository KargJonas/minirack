# Keep the loader small so it fits comfortably in the 1MB factory partition
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# If an uploaded app crashes before calling esp_ota_mark_app_valid_cancel_rollback()
# (RackOTA.begin() does this), the bootloader falls back to the previous image,
# ultimately this loader. Recovery without serial access.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
